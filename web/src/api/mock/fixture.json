{
 "schema": {
  "$defs": {
   "AgentDef": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean",
      "widget": "switch"
     },
     "timeout_s": {
      "default": 20,
      "maximum": 120,
      "minimum": 1,
      "title": "Timeout S",
      "type": "integer",
      "widget": "number"
     },
     "max_tool_calls": {
      "default": 12,
      "maximum": 50,
      "minimum": 1,
      "title": "Max Tool Calls",
      "type": "integer",
      "widget": "number"
     },
     "model_override": {
      "anyOf": [
       {
        "$ref": "#/$defs/ModelDef"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "widget": "model_picker"
     },
     "prompt_ref": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Prompt Ref",
      "widget": "prompt_ref"
     }
    },
    "title": "AgentDef",
    "type": "object"
   },
   "CheckpointCfg": {
    "additionalProperties": false,
    "properties": {
     "requirement_confirmation": {
      "default": true,
      "title": "Requirement Confirmation",
      "type": "boolean",
      "widget": "switch"
     },
     "batched_async": {
      "default": false,
      "title": "Batched Async",
      "type": "boolean",
      "widget": "switch"
     }
    },
    "title": "CheckpointCfg",
    "type": "object"
   },
   "ClauseDef": {
    "additionalProperties": false,
    "properties": {
     "title": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Title",
      "type": "string"
     },
     "negotiable": {
      "default": true,
      "title": "Negotiable",
      "type": "boolean",
      "widget": "switch"
     },
     "locked": {
      "default": false,
      "forced_for": [
       "liability",
       "termination",
       "ip"
      ],
      "title": "Locked",
      "type": "boolean",
      "widget": "switch"
     }
    },
    "required": [
     "title"
    ],
    "title": "ClauseDef",
    "type": "object"
   },
   "DataSourcesCfg": {
    "additionalProperties": false,
    "properties": {
     "synthetic_seed": {
      "default": 42,
      "maximum": 2147483647,
      "minimum": 0,
      "title": "Synthetic Seed",
      "type": "integer",
      "widget": "number"
     },
     "news_enabled": {
      "default": true,
      "title": "News Enabled",
      "type": "boolean",
      "widget": "switch"
     },
     "weather_enabled": {
      "default": true,
      "title": "Weather Enabled",
      "type": "boolean",
      "widget": "switch"
     },
     "use_recorded_fallback": {
      "default": true,
      "title": "Use Recorded Fallback",
      "type": "boolean",
      "widget": "switch"
     },
     "egress_allowlist": {
      "admin_only": true,
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Egress Allowlist",
      "type": "array",
      "widget": "host_list"
     }
    },
    "title": "DataSourcesCfg",
    "type": "object"
   },
   "LlmSection": {
    "additionalProperties": false,
    "properties": {
     "mode": {
      "default": "replay",
      "enum": [
       "live",
       "replay",
       "record"
      ],
      "title": "Mode",
      "type": "string",
      "widget": "select"
     },
     "roles": {
      "additionalProperties": {
       "$ref": "#/$defs/ModelDef"
      },
      "keys": [
       "fast",
       "chat"
      ],
      "title": "Roles",
      "type": "object",
      "widget": "role_models"
     },
     "tokens_per_project": {
      "default": 400000,
      "maximum": 10000000,
      "minimum": 1000,
      "title": "Tokens Per Project",
      "type": "integer",
      "widget": "number"
     },
     "replay_fallback_live": {
      "default": false,
      "title": "Replay Fallback Live",
      "type": "boolean",
      "widget": "switch"
     }
    },
    "title": "LlmSection",
    "type": "object"
   },
   "ModelDef": {
    "additionalProperties": false,
    "properties": {
     "provider": {
      "title": "Provider",
      "type": "string",
      "widget": "provider_picker"
     },
     "model": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Model",
      "type": "string",
      "widget": "model_picker"
     },
     "temperature": {
      "default": 0.0,
      "maximum": 2,
      "minimum": 0,
      "title": "Temperature",
      "type": "number",
      "widget": "number"
     },
     "max_tokens": {
      "default": 1024,
      "maximum": 16000,
      "minimum": 16,
      "title": "Max Tokens",
      "type": "integer",
      "widget": "number"
     },
     "timeout_s": {
      "default": 20.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "Timeout S",
      "type": "number",
      "widget": "number"
     },
     "thinking": {
      "default": "auto",
      "enum": [
       "auto",
       "on",
       "off"
      ],
      "title": "Thinking",
      "type": "string",
      "widget": "select"
     }
    },
    "required": [
     "provider",
     "model"
    ],
    "title": "ModelDef",
    "type": "object"
   },
   "NegotiationCfg": {
    "additionalProperties": false,
    "properties": {
     "max_rounds": {
      "default": 4,
      "maximum": 8,
      "minimum": 1,
      "title": "Max Rounds",
      "type": "integer",
      "widget": "number"
     },
     "min_step_pct": {
      "anyOf": [
       {
        "maximum": 20.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "0.5",
      "title": "Min Step Pct",
      "widget": "number"
     },
     "concession": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 1.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "0.45",
      "title": "Concession",
      "widget": "number"
     },
     "opening_discount": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 1.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "0.90",
      "title": "Opening Discount",
      "widget": "number"
     },
     "delay_penalty_pct": {
      "anyOf": [
       {
        "maximum": 100.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "20",
      "title": "Delay Penalty Pct",
      "widget": "number"
     }
    },
    "title": "NegotiationCfg",
    "type": "object"
   },
   "PromptDef": {
    "additionalProperties": false,
    "description": "Instruction BODY only. Preamble, <untrusted_data> wrapper and output schema are code-owned (rule 17).",
    "properties": {
     "body": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Body",
      "type": "string",
      "variables_from": "allowed_vars",
      "widget": "prompt_body"
     }
    },
    "required": [
     "body"
    ],
    "title": "PromptDef",
    "type": "object"
   },
   "ProviderDef": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "$ref": "#/$defs/ProviderKindEnum",
      "widget": "select"
     },
     "base_url": {
      "default": "",
      "maxLength": 300,
      "title": "Base Url",
      "type": "string",
      "widget": "url"
     },
     "is_local": {
      "admin_only": true,
      "default": false,
      "help": "Allows private/loopback hosts. ADMIN-set; validated as SSRF input.",
      "title": "Is Local",
      "type": "boolean",
      "widget": "switch"
     },
     "key_ref": {
      "anyOf": [
       {
        "maxLength": 60,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "help": "Name of the write-only vault entry. The key itself is never part of the config.",
      "title": "Key Ref",
      "widget": "secret_ref"
     }
    },
    "required": [
     "kind"
    ],
    "title": "ProviderDef",
    "type": "object"
   },
   "ProviderKindEnum": {
    "enum": [
     "OLLAMA",
     "ANTHROPIC",
     "OPENAI_COMPATIBLE",
     "STUB"
    ],
    "title": "ProviderKindEnum",
    "type": "string"
   },
   "RuleDef": {
    "additionalProperties": false,
    "description": "Extra policy rule. Can only ADD a stop (BLOCK/ESCALATE) after invariant rules pass; never allows anything.",
    "properties": {
     "id": {
      "pattern": "^CFG_[A-Z0-9_]{2,40}$",
      "title": "Id",
      "type": "string"
     },
     "description": {
      "default": "",
      "maxLength": 200,
      "title": "Description",
      "type": "string"
     },
     "signal": {
      "enum": [
       "offer_lead_time_weeks",
       "offer_unit_price_vs_index_pct",
       "offer_round"
      ],
      "title": "Signal",
      "type": "string",
      "widget": "select"
     },
     "op": {
      "enum": [
       ">",
       ">=",
       "<",
       "<="
      ],
      "title": "Op",
      "type": "string",
      "widget": "select"
     },
     "value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "title": "Value",
      "widget": "number"
     },
     "action": {
      "default": "ESCALATE",
      "enum": [
       "ESCALATE",
       "BLOCK"
      ],
      "title": "Action",
      "type": "string",
      "widget": "select"
     },
     "enabled": {
      "default": true,
      "title": "Enabled",
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "signal",
     "op",
     "value"
    ],
    "title": "RuleDef",
    "type": "object"
   },
   "ScenarioDef": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "need_index": {
      "default": 0,
      "maximum": 999,
      "minimum": 0,
      "title": "Need Index",
      "type": "integer",
      "widget": "number"
     },
     "buyer_max_factor": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 10.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "1.45",
      "title": "Buyer Max Factor",
      "widget": "number"
     },
     "buyer_target_factor": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 10.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "1.0",
      "title": "Buyer Target Factor",
      "widget": "number"
     },
     "margin_pct": {
      "anyOf": [
       {
        "maximum": 500.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "15",
      "title": "Margin Pct",
      "widget": "number"
     },
     "min_buyer_rating": {
      "anyOf": [
       {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "type": "string"
       }
      ],
      "default": "0.3",
      "title": "Min Buyer Rating",
      "widget": "number"
     },
     "poisoned_news": {
      "default": false,
      "title": "Poisoned News",
      "type": "boolean",
      "widget": "switch"
     },
     "supplier_behaviours": {
      "additionalProperties": {
       "enum": [
        "cooperative",
        "aggressive",
        "unreliable",
        "adversarial"
       ],
       "type": "string"
      },
      "title": "Supplier Behaviours",
      "type": "object",
      "widget": "behaviour_map"
     }
    },
    "required": [
     "name"
    ],
    "title": "ScenarioDef",
    "type": "object"
   },
   "StageEnum": {
    "enum": [
     "NEED",
     "DISCOVERY",
     "QUALIFICATION",
     "SOURCING",
     "CONTRACTING",
     "ONBOARDING",
     "DONE"
    ],
    "title": "StageEnum",
    "type": "string"
   },
   "WorkflowCfg": {
    "additionalProperties": false,
    "properties": {
     "disabled_stages": {
      "default": [],
      "items": {
       "$ref": "#/$defs/StageEnum"
      },
      "optional_only": true,
      "title": "Disabled Stages",
      "type": "array",
      "widget": "stage_toggles"
     },
     "autonomy": {
      "additionalProperties": {
       "type": "integer"
      },
      "max": 4,
      "min": 1,
      "propertyNames": {
       "$ref": "#/$defs/StageEnum"
      },
      "title": "Autonomy",
      "type": "object",
      "widget": "autonomy"
     },
     "checkpoints": {
      "$ref": "#/$defs/CheckpointCfg"
     },
     "negotiation": {
      "$ref": "#/$defs/NegotiationCfg"
     },
     "longlist_size": {
      "default": 10,
      "maximum": 50,
      "minimum": 1,
      "title": "Longlist Size",
      "type": "integer",
      "widget": "number"
     },
     "shortlist_size": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "title": "Shortlist Size",
      "type": "integer",
      "widget": "number"
     },
     "negotiate_top": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "title": "Negotiate Top",
      "type": "integer",
      "widget": "number"
     },
     "min_countries": {
      "default": 2,
      "maximum": 10,
      "minimum": 1,
      "title": "Min Countries",
      "type": "integer",
      "widget": "number"
     },
     "concurrency": {
      "default": 8,
      "maximum": 32,
      "minimum": 1,
      "title": "Concurrency",
      "type": "integer",
      "widget": "number"
     },
     "news_timeout_s": {
      "default": 20.0,
      "exclusiveMinimum": 0,
      "maximum": 300,
      "title": "News Timeout S",
      "type": "number",
      "widget": "number"
     },
     "news_escalate_severity": {
      "default": 0.7,
      "maximum": 1,
      "minimum": 0,
      "title": "News Escalate Severity",
      "type": "number",
      "widget": "number"
     },
     "news_min_confidence": {
      "default": 0.6,
      "maximum": 1,
      "minimum": 0,
      "title": "News Min Confidence",
      "type": "number",
      "widget": "number"
     },
     "standard_clauses": {
      "default": [
       "payment_terms",
       "delivery",
       "warranty",
       "liability",
       "termination",
       "ip"
      ],
      "items": {
       "type": "string"
      },
      "title": "Standard Clauses",
      "type": "array",
      "widget": "clause_multi"
     }
    },
    "title": "WorkflowCfg",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "schema_version": {
    "default": 1,
    "title": "Schema Version",
    "type": "integer"
   },
   "providers": {
    "patternProperties": {
     "^[a-z][a-z0-9_]{0,39}$": {
      "$ref": "#/$defs/ProviderDef"
     }
    },
    "title": "Providers",
    "type": "object",
    "widget": "providers"
   },
   "llm": {
    "$ref": "#/$defs/LlmSection"
   },
   "agents": {
    "additionalProperties": {
     "$ref": "#/$defs/AgentDef"
    },
    "keys": [
     "buyer_lead",
     "supplier_lead",
     "research_suppliers",
     "compliance_screen",
     "regional_news_risk",
     "weather_logistics",
     "landed_cost",
     "quote_generation",
     "buyer_verification",
     "capacity_margin",
     "demand_forecast",
     "compliance_docs"
    ],
    "title": "Agents",
    "type": "object",
    "widget": "agents"
   },
   "prompts": {
    "additionalProperties": {
     "$ref": "#/$defs/PromptDef"
    },
    "title": "Prompts",
    "type": "object",
    "widget": "prompts"
   },
   "workflow": {
    "$ref": "#/$defs/WorkflowCfg"
   },
   "rules": {
    "default": [],
    "items": {
     "$ref": "#/$defs/RuleDef"
    },
    "title": "Rules",
    "type": "array",
    "widget": "rule_builder"
   },
   "clauses": {
    "additionalProperties": {
     "$ref": "#/$defs/ClauseDef"
    },
    "title": "Clauses",
    "type": "object",
    "widget": "clauses"
   },
   "data_sources": {
    "$ref": "#/$defs/DataSourcesCfg"
   },
   "scenarios": {
    "patternProperties": {
     "^[a-z][a-z0-9_]{0,39}$": {
      "$ref": "#/$defs/ScenarioDef"
     }
    },
    "title": "Scenarios",
    "type": "object",
    "widget": "scenarios"
   }
  },
  "title": "StudioConfig",
  "type": "object",
  "x-agent-keys": [
   "buyer_lead",
   "supplier_lead",
   "research_suppliers",
   "compliance_screen",
   "regional_news_risk",
   "weather_logistics",
   "landed_cost",
   "quote_generation",
   "buyer_verification",
   "capacity_margin",
   "demand_forecast",
   "compliance_docs"
  ],
  "x-required-agents": [
   "buyer_lead",
   "buyer_verification",
   "capacity_margin",
   "compliance_docs",
   "compliance_screen",
   "landed_cost",
   "quote_generation",
   "research_suppliers",
   "supplier_lead"
  ],
  "x-prompt-agents": [
   "regional_news_risk"
  ]
 },
 "invariants": [
  {
   "id": "INV_SCHEMA_STRICT",
   "title": "Config contains only known fields",
   "description": "Extra keys are how injected switches get through"
  },
  {
   "id": "INV_AUDIT_CHAIN",
   "title": "Audit logging and hash chain are always on",
   "description": "Without it actions cannot be proven"
  },
  {
   "id": "INV_SIGNING",
   "title": "Message signing and schema validation are always on",
   "description": "Unsigned messages are unattributable"
  },
  {
   "id": "INV_MANDATE_ENFORCEMENT",
   "title": "Mandates are enforced by the policy engine; rounds hard-capped at 8",
   "description": "Prompts can be talked around, code cannot"
  },
  {
   "id": "INV_MANDATE_SECRECY",
   "title": "Counterparty mandates are never visible",
   "description": "Limits leak the floor/ceiling"
  },
  {
   "id": "INV_WATCHLIST_NO_AUTOCLEAR",
   "title": "Watchlist hits are never auto-cleared",
   "description": "Sanctions risk needs a human"
  },
  {
   "id": "INV_RULES_ONLY_QUAL",
   "title": "Qualification status is set only by compliance rules",
   "description": "LLM output must not qualify suppliers"
  },
  {
   "id": "INV_LOCKED_CLAUSES",
   "title": "liability, termination, ip are locked, non-negotiable and in every contract",
   "description": "Legal must review them"
  },
  {
   "id": "INV_COMPLIANCE_ENABLED",
   "title": "Compliance screen cannot be disabled",
   "description": "Required for sanctions/forced-labor control"
  },
  {
   "id": "INV_CONTRACT_AUTONOMY_MAX_L2",
   "title": "Contracting autonomy <= L2",
   "description": "Contract acts need human approval"
  },
  {
   "id": "INV_STAGES_FIXED",
   "title": "Only optional stages may be disabled",
   "description": "Stage order and mandatory stages are fixed"
  },
  {
   "id": "INV_HOLD_RELEASE_BUYER",
   "title": "Payment hold release only by FINANCE (and other human checkpoints stay human)",
   "description": "Segregation of duties"
  },
  {
   "id": "INV_WRAPPER_PRESENT",
   "title": "Untrusted-data wrapper, English preamble and schema suffix are code-owned",
   "description": "A body that replaces the wrapper is an injection tool"
  },
  {
   "id": "INV_RULES_ADD_ONLY",
   "title": "Configured rules can only add stops",
   "description": "Config must not weaken invariant rules"
  },
  {
   "id": "INV_FAIL_CLOSED",
   "title": "Validation, parse and timeout errors fail closed",
   "description": "Blank never means pass"
  },
  {
   "id": "INV_LLM_NEVER_EXECUTED",
   "title": "LLM output never executes an action",
   "description": "Output trust is mandate bypass"
  },
  {
   "id": "INV_NO_SECRETS",
   "title": "Secrets are never part of a config",
   "description": "Keys live in the vault only"
  }
 ],
 "config": {
  "schema_version": 1,
  "providers": {
   "ollama": {
    "kind": "OLLAMA",
    "base_url": "http://localhost:11434",
    "is_local": true,
    "key_ref": null
   }
  },
  "llm": {
   "mode": "replay",
   "roles": {
    "fast": {
     "provider": "ollama",
     "model": "gemma4:e2b-mlx",
     "temperature": 0.0,
     "max_tokens": 512,
     "timeout_s": 120.0,
     "thinking": "auto"
    },
    "chat": {
     "provider": "ollama",
     "model": "qwen3.8:27b-mlx",
     "temperature": 0.0,
     "max_tokens": 1024,
     "timeout_s": 120.0,
     "thinking": "auto"
    }
   },
   "tokens_per_project": 400000,
   "replay_fallback_live": false
  },
  "agents": {
   "buyer_lead": {
    "enabled": true,
    "timeout_s": 20,
    "max_tool_calls": 12,
    "model_override": null,
    "prompt_ref": null
   },
   "supplier_lead": {
    "enabled": true,
    "timeout_s": 20,
    "max_tool_calls": 12,
    "model_override": null,
    "prompt_ref": null
   },
   "research_suppliers": {
    "enabled": true,
    "timeout_s": 20,
    "max_tool_calls": 12,
    "model_override": null,
    "prompt_ref": null
   },
   "compliance_screen": {
    "enabled": true,
    "timeout_s": 20,
