# Copy to .env (gitignored). Bootstrap secrets are env-only; user-changeable settings (llm_mode, token budget) live in the DB.
# dev | prod (prod: no /docs, JWT_SECRET required, HSTS)
APP_ENV=dev
# docker-compose overrides to /data/sourceloop.db
DATABASE_URL=sqlite+aiosqlite:///./data/sourceloop.db
# >= 32 bytes; REQUIRED in prod. Empty in dev => random per process (sessions reset on restart)
JWT_SECRET=
# mandate/message signing master secret; defaults to JWT_SECRET
ORG_SIGNING_SECRET=
# Fernet key for provider keys stored via the Studio (required in prod)
CONFIG_ENCRYPTION_KEY=
# prod: REQUIRED, explicit https:// origins (no *); prod also forces Secure cookies (COOKIE_SECURE=true)
CORS_ORIGINS=http://localhost:3010
# replay | live | record (fallback; app_setting wins)
LLM_MODE=replay
OLLAMA_BASE_URL=http://localhost:11434
TOKEN_BUDGET_PER_PROJECT=400000
RATE_LIMIT_DEFAULT=600/minute
RATE_LIMIT_LOGIN=20/minute
# per-user limits (defaults shown; raise only for load/e2e runs)
RATE_LIMIT_CREATE=10/hour
# start + resume share one bucket
RATE_LIMIT_START=5/hour
RATE_LIMIT_RESOLVE=60/minute
# self-registration: defaults to true in dev and FALSE when APP_ENV=prod
REGISTRATION_ENABLED=true
# Test bed: login page is a role picker, no password (default true; set false to require passwords) (seeded @sourceloop.test accounts only; ignored when APP_ENV=prod)
DEMO_ROLE_LOGIN=true
# reverse proxies in front of the API (0 = X-Forwarded-For ignored for rate-limit keys)
TRUSTED_PROXY_HOPS=0
MAX_ACTIVE_PROJECTS_PER_ORG=20
LOG_LEVEL=INFO
# Ports: API host 8005 (container 8000); web (later) 3010.

# External audit anchor: append-only file the audit verify endpoint cross-checks (empty = off). Docker sets /data/anchors/audit-anchors.jsonl
AUDIT_ANCHOR_PATH=./data/anchors/audit-anchors.jsonl

# Bootstrap-only model names for the first published Studio config (seed). Empty = built-in defaults. install-mac.sh sets qwen3.5:4b.
SL_FAST_MODEL=
SL_CHAT_MODEL=
